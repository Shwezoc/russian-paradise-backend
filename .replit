modules = ["python-3.12", "nodejs-24"]

[nix]
channel = "stable-25_05"
packages = ["postgresql"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m http.server 5000 --bind 0.0.0.0 --directory frontend"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
